{
  "name": "WF4 — Event Router Webhook",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "grofast/events",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "wf4-n01",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "grofast-events-wf4"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.event }}", "rightValue": "leave.submitted", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "wf4-n02",
      "name": "IF leave.submitted",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json\nconst fmt = d => new Date(d).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'numeric'})\nconst message =\n  `\\uD83D\\uDCCB Leave Request \\u2014 Action Required\\n\\n` +\n  `${b.employee_name} (${b.employee_id}) has applied for leave:\\n` +\n  `\\uD83D\\uDCC5 From  : ${fmt(b.from_date)}\\n` +\n  `\\uD83D\\uDCC5 To    : ${fmt(b.to_date)}\\n` +\n  `\\uD83D\\uDCDD Reason: ${b.reason}\\n\\n` +\n  `Approve or reject in the admin panel.\\n` +\n  `\\uD83D\\uDC49 grofastteam.vercel.app/admin/leaves`\nreturn [{ json: { phone: b.admin_phone, message } }]"
      },
      "id": "wf4-n03",
      "name": "Format Leave Submitted",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 120]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "recipientPhoneNumber": "={{ $json.phone }}",
        "messageType": "text",
        "textBody": "={{ $json.message }}"
      },
      "credentials": { "whatsAppApi": { "id": "1", "name": "WhatsApp account" } },
      "id": "wf4-n04",
      "name": "WA Admin Leave Submitted",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [960, 120]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.event }}", "rightValue": "leave.approved", "operator": { "type": "string", "operation": "equals" } },
            { "id": "c2", "leftValue": "={{ $json.event }}", "rightValue": "leave.rejected", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "wf4-n05",
      "name": "IF leave status",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [700, 300]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json\nconst fmt = d => new Date(d).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'numeric'})\nconst approved = b.status === 'approved'\nconst emoji = approved ? '\\u2705' : '\\u274C'\nconst label = approved ? 'Approved' : 'Rejected'\nconst firstName = b.employee_name.split(' ')[0]\nconst message =\n  `${emoji} Leave ${label}\\n\\n` +\n  `Hey ${firstName}, your leave request has been ${b.status}.\\n\\n` +\n  `\\uD83D\\uDCC5 From : ${fmt(b.from_date)}\\n` +\n  `\\uD83D\\uDCC5 To   : ${fmt(b.to_date)}\\n\\n` +\n  `\\u2014 GroFast System`\nreturn [{ json: { phone: b.employee_phone, message } }]"
      },
      "id": "wf4-n06",
      "name": "Format Leave Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 480]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "recipientPhoneNumber": "={{ $json.phone }}",
        "messageType": "text",
        "textBody": "={{ $json.message }}"
      },
      "credentials": { "whatsAppApi": { "id": "1", "name": "WhatsApp account" } },
      "id": "wf4-n07",
      "name": "WA Employee Leave Status",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [1220, 480]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.event }}", "rightValue": "hours.underperformance", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "wf4-n08",
      "name": "IF hours.underperformance",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json\nconst shortfall = Math.round((b.expected_hours - b.working_hours) * 10) / 10\nconst dateDisplay = new Date(b.date).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'numeric'})\nconst message =\n  `\\u26A0\\uFE0F Low Hours Alert\\n\\n` +\n  `${b.employee_name} (${b.employee_id}) submitted today:\\n` +\n  `\\uD83D\\uDCC5 Date      : ${dateDisplay}\\n` +\n  `\\u23F1 Worked    : ${b.working_hours}h\\n` +\n  `\\uD83C\\uDFAF Required  : ${b.expected_hours}h\\n` +\n  `\\uD83D\\uDCC9 Shortfall : ${shortfall}h\\n\\n` +\n  `\\u2014 GroFast System`\nreturn [{ json: { phone: b.admin_phone, message } }]"
      },
      "id": "wf4-n09",
      "name": "Format Hours Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1220, 120]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "recipientPhoneNumber": "={{ $json.phone }}",
        "messageType": "text",
        "textBody": "={{ $json.message }}"
      },
      "credentials": { "whatsAppApi": { "id": "1", "name": "WhatsApp account" } },
      "id": "wf4-n10",
      "name": "WA Admin Hours",
      "type": "n8n-nodes-base.whatsApp",
      "typeVersion": 1,
      "position": [1480, 120]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.event }}", "rightValue": "daily_update.submitted", "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "wf4-n11",
      "name": "IF daily_update.submitted",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1220, 300]
    },
    {
      "parameters": {
        "jsCode": "const b = $input.first().json\nconst dateDisplay = new Date(b.date).toLocaleDateString('en-IN', {day:'numeric', month:'short', year:'numeric'})\nconst statusEmoji = b.attendance_status === 'wfh' ? '\\uD83C\\uDFE0' : '\\uD83C\\uDFE2'\nlet message =\n  `\\uD83D\\uDCCB Daily Update Submitted\\n\\n` +\n  `${b.employee_name} (${b.employee_id})\\n` +\n  `\\uD83D\\uDCC5 Date   : ${dateDisplay}\\n` +\n  `${statusEmoji} Status : ${b.attendance_status}`\nif (b.working_hours != null) message += `\\n\\u23F1 Hours  : ${b.working_hours}h`\nif (b.shoot_count > 0) message += `\\n\\uD83D\\uDCF8 Shoots : ${b.shoot_count}`\nmessage += `\\n\\n\\u2014 GroFast System`\nreturn [{ json: { phone: b.admin_phone, message } }]"
      },
      "id": "wf4-n12",
      "name": "Format Daily Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1480, 480]
    },
    {
