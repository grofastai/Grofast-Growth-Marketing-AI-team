{
  "name": "GroFast — Leave Button Handler",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "grofast-leave-action",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "wh-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "grofast-leave-action"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true },
          "conditions": [
            {
              "id": "cond-type",
              "leftValue": "={{ $json.body.entry[0].changes[0].value.messages[0].type }}",
              "rightValue": "interactive",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "id": "cond-btn",
              "leftValue": "={{ $json.body.entry[0].changes[0].value.messages[0].interactive.type }}",
              "rightValue": "button_reply",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-button",
      "name": "Is Button Reply?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://grofastteam.vercel.app/api/webhooks/whatsapp",
        "sendBody": true,
        "contentType": "json",
        "body": "={{ JSON.stringify($json.body) }}",
        "options": { "timeout": 10000 }
      },
      "id": "http-forward",
      "name": "Forward to GroFast App",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 180]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "ok",
        "options": {}
      },
      "id": "respond-ok",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [680, 420]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [{ "node": "Is Button Reply?", "type": "main", "index": 0 }]
      ]
    },
    "Is Button Reply?": {
      "main": [
        [{ "node": "Forward to GroFast App", "type": "main", "index": 0 }],
        [{ "node": "Respond OK", "type": "main", "index": 0 }]
      ]
    },
    "Forward to GroFast App": {
      "main": [
        [{ "node": "Respond OK", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "tags": ["GroFast Team"]
}
