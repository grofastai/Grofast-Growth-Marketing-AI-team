# ============================================================
# SUPABASE — get from: dashboard.supabase.com → Project Settings → API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ4eW96ZWxsZHFlcmx2dGp3c2FpIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3NzE3NDY2MCwiZXhwIjoyMDkyNzUwNjYwfQ.P1ymn8RW1-i9iPZd50tG2qxs-8LrAGn-7KCSahSNOFg

# ============================================================
# APP URLs
# NEXT_PUBLIC_APP_URL — available in the browser (client-side navigation, etc.)
# APP_BASE_URL        — server-only, used to build WhatsApp/email links (never exposed to browser)
# ============================================================
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
APP_BASE_URL=https://your-app.vercel.app

# ============================================================
# VERCEL CRON AUTH
# CRON_SECRET: Vercel auto-generates this — copy from Vercel dashboard → Settings → Environment Variables
# CRON_COMPANY_ID: Your company UUID from Supabase companies table
# ============================================================
CRON_SECRET=COPY_FROM_VERCEL_DASHBOARD
CRON_COMPANY_ID=YOUR_COMPANY_UUID

# ============================================================
# INTERNAL WEBHOOK SECRET
# Used to manually trigger cron endpoints (e.g. for testing)
# Generate with: openssl rand -hex 32
# ============================================================
INTERNAL_WEBHOOK_SECRET=CHOOSE_A_RANDOM_SECRET_STRING

# ============================================================
# GOOGLE DRIVE — media team video uploads
# Service account JSON (single line) from Google Cloud Console
# ============================================================
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# Optional: pre-set the MediaUploads root folder ID (auto-created if omitted)
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ============================================================
# META WHATSAPP CLOUD API
# Get from: Meta Business Suite → WhatsApp → API Setup
# ============================================================
META_WHATSAPP_TOKEN=YOUR_PERMANENT_TOKEN
META_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_ONBOARDING_TEMPLATE=welcome_onboarding
# Used to verify Meta's webhook subscription handshake — set a random string
META_WHATSAPP_VERIFY_TOKEN=CHOOSE_A_RANDOM_STRING
