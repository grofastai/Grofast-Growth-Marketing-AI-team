# ============================================================
# APP URLs
# NEXT_PUBLIC_APP_URL — available in the browser (client-side navigation, etc.)
# APP_BASE_URL        — server-only, used to build WhatsApp/email links (never exposed to browser)
# ============================================================
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
APP_BASE_URL=https://your-app.vercel.app

# ============================================================
# n8n WHATSAPP WEBHOOK
# After creating the n8n workflow, paste the webhook URL here.
# Get it from: n8n → your workflow → Webhook node → copy URL
# ============================================================
N8N_WEBHOOK_URL=https://YOUR_N8N_INSTANCE/webhook/grofast-notify
N8N_WEBHOOK_SECRET=CHOOSE_A_RANDOM_SECRET_STRING

# ============================================================
# INTERNAL WEBHOOK SECRET
# Used to authenticate calls from Next.js → /api/webhooks/notify
# Generate with: openssl rand -hex 32
# ============================================================
INTERNAL_WEBHOOK_SECRET=CHOOSE_A_RANDOM_SECRET_STRING

# ============================================================
# WHATSAPP (set in n8n, not here — but keep for reference)
# Option A: Twilio WhatsApp
#   TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_FROM
# Option B: 360dialog
#   DIALOG360_API_KEY, DIALOG360_PHONE_NUMBER_ID
# Option C: Meta WhatsApp Cloud API
#   META_WHATSAPP_TOKEN, META_PHONE_NUMBER_ID
# ============================================================
